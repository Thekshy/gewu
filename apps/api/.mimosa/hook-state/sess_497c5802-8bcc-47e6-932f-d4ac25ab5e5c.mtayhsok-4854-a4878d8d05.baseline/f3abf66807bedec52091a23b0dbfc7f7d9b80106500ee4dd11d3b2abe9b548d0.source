"""每日 token 预算：公开 demo 的成本防线，超限直接拒绝 LLM 调用。"""

import datetime as dt
import json
import threading
from pathlib import Path

from .config import get_settings


class BudgetExceeded(Exception):
    pass


class TokenBudget:
    """以天为单位累计 token 用量，持久化在 data/usage.json，跨重启有效。"""

    def __init__(self, path: Path, daily_limit: int):
        self.path = path
        self.daily_limit = daily_limit
        self._lock = threading.Lock()

    def _load(self) -> dict:
        today = dt.date.today().isoformat()
        try:
            data = json.loads(self.path.read_text("utf-8"))
        except (OSError, ValueError):
            data = {}
        if data.get("date") != today:
            data = {"date": today, "tokens": 0}
        return data

    def used(self) -> int:
        return int(self._load().get("tokens", 0))

    def ensure(self) -> None:
        if self.used() >= self.daily_limit:
            raise BudgetExceeded(f"今日 token 预算已用尽（上限 {self.daily_limit}），请明天再试")

    def add(self, n: int) -> None:
        if n <= 0:
            return
        with self._lock:
            data = self._load()
            data["tokens"] = int(data.get("tokens", 0)) + n
            self.path.parent.mkdir(parents=True, exist_ok=True)
            self.path.write_text(json.dumps(data, ensure_ascii=False), "utf-8")


_settings = get_settings()
budget = TokenBudget(_settings.data_dir / "usage.json", _settings.daily_token_budget)
