# gewu API 服务（P14 起 Python + LangGraph；uv 单阶段，镜像含语料与依赖锁定）
FROM python:3.12-slim
# uv 官方推荐方式安装（无需 apt 源）
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN adduser --disabled-password --gecos "" --uid 10001 gewu
WORKDIR /srv
# 先装依赖（利用层缓存：pyproject/uv.lock 变化才重装）
COPY apps/server/pyproject.toml apps/server/uv.lock ./
RUN uv sync --frozen --no-install-project
COPY apps/server ./
COPY data ./data
RUN uv sync --frozen
# 运行用户对数据目录可写（业务库/记忆/预算文件都落在 /srv/data）
RUN chown -R gewu:gewu /srv/data
ENV DATA_DIR=/srv/data UV_RUN_NO_SYNC=1
USER gewu
EXPOSE 8000
CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
