FROM node:22-alpine AS build
WORKDIR /srv

COPY apps/web/package.json ./
RUN npm install

COPY apps/web ./
ARG NEXT_PUBLIC_API_BASE=http://localhost:8000
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
RUN npm run build

FROM node:22-alpine
WORKDIR /srv
ENV NODE_ENV=production
COPY --from=build /srv ./
EXPOSE 3100
CMD ["npm", "start"]
