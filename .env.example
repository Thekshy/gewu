# ===== LLM（任意 OpenAI 兼容端点均可；P6 起强制有 key 启动）=====
# 智谱编码套餐示例（端点不同！）；换标准 API: https://open.bigmodel.cn/api/paas/v4
# 换 DeepSeek: https://api.deepseek.com/v1 + deepseek-chat；换 OpenAI: https://api.openai.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/
LLM_MODEL=glm-5.3
# 辅助调用（路由/拆解/槽位抽取/查询改写/精排）用小模型，主答案用 LLM_MODEL
LLM_SMALL_MODEL=glm-5.3-flash
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=embedding-3
# glm-5.3 等推理模型建议开启（关闭思考直出，更快更省）；非智谱端点保持 false
LLM_DISABLE_THINKING=true

# ===== 服务与防护 =====
RATE_LIMIT_PER_MINUTE=20
DAILY_TOKEN_BUDGET=2000000
RETRIEVAL_K=6

# ===== 检索存储（P12：PostgreSQL + pgvector；make pg-up 起本地容器）=====
# 缺省指向 compose/CI 的 5433；本机宿主若跑共享 postmaster（brew services，
# 多项目共用，端口 5432），复制本段到 .env 改端口即可覆盖：
# PG_DSN=postgres://gewu:gewu@127.0.0.1:5432/gewu?sslmode=disable

# 留空即可：默认为仓库根目录的 data/
# DATA_DIR=

# ===== 行为开关（全绿门禁下灰度；缺省见 internal/config）=====
# 路由：cascade（默认，L0 规则快路径 + L1 小模型 + L2 主模型复核）| classic（旧单次分类）| agent-first（三策略分流 + ReAct）
# ROUTER_MODE=cascade
# 切分：hierarchical（默认，父子块）| flat
# CHUNK_MODE=hierarchical
# LLM 精排：on（默认）| off
# RERANK_MODE=on
# 路径不定的办理问题转 ReAct：off（默认）| on
# REACT_MODE=off
# 多轮指代消解补全：on（默认）| off
# QUERY_REWRITE=on
# 办理会话存储：sqlite（默认，data/sessions.db，跨重启续办）| memory
# SESSION_STORE=sqlite
