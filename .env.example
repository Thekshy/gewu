# ===== LLM（任意 OpenAI 兼容端点均可）=====
# 智谱示例；换 DeepSeek: https://api.deepseek.com/v1 + deepseek-chat；换 OpenAI: https://api.openai.com/v1 + gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.6
EMBED_MODEL=embedding-3

# ===== 服务与防护 =====
RATE_LIMIT_PER_MINUTE=20
DAILY_TOKEN_BUDGET=2000000
RETRIEVAL_K=6

# 留空即可：默认为仓库根目录的 data/
# DATA_DIR=
