# ===== LLM（任意 OpenAI 兼容端点均可；P6 起强制有 key 启动）=====
# 智谱编码套餐示例（端点不同！）；换标准 API: https://open.bigmodel.cn/api/paas/v4
# 换 DeepSeek: https://api.deepseek.com/v1 + deepseek-chat；换 OpenAI: https://api.openai.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/
LLM_MODEL=glm-5.3
# 辅助调用（深研拆解/精排/上下文压缩/追问/记忆固化）用小模型，主答案用 LLM_MODEL
LLM_SMALL_MODEL=glm-5.3-flash
# glm-5.3 等推理模型建议开启（关闭思考直出，更快更省）；非智谱端点保持 false
LLM_DISABLE_THINKING=true

# ===== 向量（可与 LLM 不同供应商）=====
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=embedding-3
# text（标准 /embeddings 批量）| ark_multimodal（火山多模态，逐条并发）
# EMBED_MODE=text

# ===== 检索存储（P12：PostgreSQL + pgvector；make pg-up 起本地容器）=====
# 缺省指向 compose/CI 的 5433；本机宿主若跑共享 postmaster（brew services，
# 多项目共用，端口 5432），复制本段到 .env 改端口即可覆盖：
# PG_DSN=postgres://gewu:gewu@127.0.0.1:5432/gewu?sslmode=disable

# 留空即可：默认为仓库根目录的 data/
# DATA_DIR=

# ===== 服务与防护 =====
# RATE_LIMIT_PER_MINUTE=600
# DAILY_TOKEN_BUDGET=2000000
# DAILY_USER_BUDGET=200000
# https 上线后生产环境开启（会话 cookie 带 Secure 标志；本地 http 保持 false）
# COOKIE_SECURE=false
# 跨域白名单（逗号分隔；空=仅同源——前端经 next rewrite 同源代理，无跨域依赖）
# CORS_ORIGINS=
# FastAPI 框架文档面 /docs /redoc /openapi.json（缺省关闭；本地调试 =1 打开）
# API_DOCS=false

# ===== 游客开放通道（P39：免登影子用户；缺省关=未登录一律 401）=====
# 线上开放 =1；游客=学生同集工具面 + 低 token 配额 + 短 TTL 会话（不续期）
# GUEST_MODE=1
# GUEST_DAILY_TOKEN_LIMIT=50000
# GUEST_SESSION_TTL_DAYS=7
# 过期游客回收：make guest-prune（缺省按 TTL 天数清理，可 DAYS=30 覆盖）

# ===== 注册模式（P39 二段）=====
# =1 开放注册：纯邮箱+密码免邀请码（register 端点 IP 5 次/分防滥用）；
# 缺省关=邀请码内测制（P21 语义）。login 页按 /api/health 的
# open_registration 字段决定是否渲染邀请码输入框。
# OPEN_REGISTRATION=1

# ===== 检索参数（P15：行为开关+参数全配置化；详见 docs/architecture/04）=====
# RETRIEVAL_K=6
# RETRIEVAL_POOL_N=20
# RRF_K=60
# RRF_VECTOR_WEIGHT=0.7
# RRF_KEYWORD_WEIGHT=0.3
# 精排引擎（P41）：flash（LLM 精排，缺省）| bailian（百炼专用 rerank）| off（on=flash 历史别名）
# RERANK_MODE=flash
# 阈值 0~10（全滤空自动退化）
# RERANK_THRESHOLD=2.0
# 精排候选拼装口径：body（裸正文，缺省）| titled（title+面包屑+正文，对齐嵌入拼装，实验口径）
# RERANK_PASSAGE=body

# ===== 百炼精排（P41：RERANK_MODE=bailian 时生效；key 空=关断退 RRF 直跑）=====
# DASHSCOPE_API_KEY=
# 工作空间域名端点（冒烟验证值；公网 https://dashscope.aliyuncs.com 同路径可替换）
# BAILIAN_RERANK_ENDPOINT=https://llm-wu8666v3ftxa4dsf.cn-beijing.maas.aliyuncs.com
# BAILIAN_RERANK_MODEL=qwen3.7-text-rerank

# ===== 切片策略链（P15：make ingest 生效；换策略/参数后必须 REBUILD=1 重建）=====
# auto（默认，画像选型：标题结构良好→heading 父子双层，否则→recursive 扁平）| heading | recursive
# CHUNK_STRATEGY=auto
# 父块/子块上限与滑切重叠（rune）
# CHUNK_PARENT_LIMIT=800
# CHUNK_CHILD_LIMIT=200
# CHUNK_OVERLAP=40

# ===== 联网检索（P26：阿里 IQS；key 空=整链关闭——工具不注册、提示词不拼准则）=====
# IQS_API_KEY=
# WEB_SEARCH_DAILY_LIMIT=200

# ===== agent 主循环（P30 流式 / P32 记忆隔离）=====
# STREAM_ANSWER=1
# 记忆固化后台抽取；全量评测时 off 隔离（见 docs/architecture/10）
# MEMORY_CONSOLIDATE=on
