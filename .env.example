# ===== LLM（任意 OpenAI 兼容端点均可）=====
# 智谱编码套餐示例（端点不同！）；换标准 API: https://open.bigmodel.cn/api/paas/v4
# 换 DeepSeek: https://api.deepseek.com/v1 + deepseek-chat；换 OpenAI: https://api.openai.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/
LLM_MODEL=glm-5.3
# 辅助调用（路由/拆解/槽位抽取/查询改写）用小模型，主答案用 LLM_MODEL
LLM_SMALL_MODEL=glm-5.3-flash
EMBED_MODEL=embedding-3
# glm-5.3 等推理模型建议开启（关闭思考直出，更快更省）；非智谱端点保持 false
LLM_DISABLE_THINKING=true

# ===== 服务与防护 =====
RATE_LIMIT_PER_MINUTE=20
DAILY_TOKEN_BUDGET=2000000
RETRIEVAL_K=6

# 留空即可：默认为仓库根目录的 data/
# DATA_DIR=

# ===== 微服务（P0 起；缺省本机直跑端口，docker compose 内由编排覆盖）=====
# 网关（对外 HTTP/SSE）与管理端口（/healthz 探针）
GATEWAY_ADDR=:8000
GATEWAY_ADMIN_ADDR=:9100
# 五个 gRPC 服务：9001 orchestrator / 9002 conversation / 9003 generate /
# 9004 tool / 9005 rag；管理端口 9101~9105
ORCHESTRATOR_ADDR=:9001
ORCHESTRATOR_ADMIN_ADDR=:9101
CONVERSATION_ADDR=:9002
CONVERSATION_ADMIN_ADDR=:9102
GENERATE_ADDR=:9003
GENERATE_ADMIN_ADDR=:9103
TOOL_ADDR=:9004
TOOL_ADMIN_ADDR=:9104
RAG_ADDR=:9005
RAG_ADMIN_ADDR=:9105

# 基础设施连接（compose 内已由服务名覆盖；本机直跑微服务时指向 localhost）
POSTGRES_DSN=postgres://gewu:gewu@localhost:5432/gewu?sslmode=disable
REDIS_ADDR=localhost:6379
MILVUS_ADDR=localhost:19530

# 结构化日志级别：debug | info | warn | error
# LOG_LEVEL=info
